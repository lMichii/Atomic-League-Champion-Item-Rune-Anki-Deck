  "excerpts": [
    {
      "id": "Zhonya%27s_Hourglass",
      "sha256": "6bbf1fcb2a994b9c054a2885272078cdfbf8028894821b16c2c48f01b96c0467",
      "text": "Unique – Time Stop: Put yourself in stasis for 2.5 seconds, rendering you untargetable and invulnerable for the duration but also unable to move, declare basic attacks, cast abilities, use summoner spells, or activate items (120 second cooldown).",
      "url": "https://wiki.leagueoflegends.com/en-us/Zhonya%27s_Hourglass"
    },
    {
      "id": "Quicksilver_Sash",
      "sha256": "566138a6501bc7f7a63e22a1df7cc6b6985cb1f844b653995392059500f07f22",
      "text": "Unique – Quicksilver: Removes all crowd control debuffs (except Airborne) from your champion (90 second cooldown).\nQuicksilver is disabled during Airborne effects.\nQuicksilver removes suppression and nearsight while Cleanse does not.\nCleanse removes summoner spell debuffs while Quicksilver does not.\nQuicksilver does not remove any accompanying, persistent effects that occur with crowd control from an enemy ability unless otherwise stated. Some examples include the tether from Malzahar's Nether Grasp, the on-hit attacks from Warwick's Infinite Duress, and the damage reduction from Exhaust.\nQuicksilver cannot remove stasis.\nNo longer cleanses Mordekaiser's Realm of Death.",
      "url": "https://wiki.leagueoflegends.com/en-us/Quicksilver_Sash"
    },
    {
      "id": "Oblivion_Orb",
      "sha256": "ae67b747c446fca24dc1d219958c7143d93e7155fc8aa3e10ad89432820c7a1e",
      "text": "Unique – Grievous Wounds: Dealing magic damage to enemy champions inflicts them with Grievous Wounds for 3 seconds.",
      "url": "https://wiki.leagueoflegends.com/en-us/Oblivion_Orb"
    },
    {
      "id": "Tiamat",
      "sha256": "f63d3d28d8fe6068bc9751c7c0767e59ab159ca1578da9934aa4191da0db7435",
      "text": "Unique – Crescent: Deal 75% AD physical damage to enemies within a 450 radius in front of you (10 second cooldown).\nUnique – Cleave: Basic attacks on-hit deal ( 40% AD / 20% AD) physical damage to other enemies in a 350 radius centered around the target.",
      "url": "https://wiki.leagueoflegends.com/en-us/Tiamat"
    },
    {
      "id": "Blade_of_the_Ruined_King",
      "sha256": "cfbc199aa97fc312124d49a2691441c1c76e484031aca36f8a43dc6476af1edf",
      "text": "Unique – Mist's Edge: Basic attacks deal bonus physical damage on-hit equal to ( 9% / 6%) of the target's current health, with a maximum of 100 against minions and monsters.\nUnique – Clawing Shadows: Basic attacks on-hit against enemy champions apply a stack for 6 seconds, stacking up to 3 times. The third stack consumes them all to slow the target by 30% for 1 second (15 second cooldown).",
      "url": "https://wiki.leagueoflegends.com/en-us/Blade_of_the_Ruined_King"
    },
    {
      "id": "Grievous_Wounds",
      "sha256": "7e24a5bbc3aa58ee7081179afc64106aeb18ff220a78d69db31f65c5ad1320b0",
      "text": "Grievous Wounds is a debuff that reduces all of a unit's healing and health regeneration received by 40%.\nShields are a way of temporarily adding health to a champion that is not reduced by Grievous Wounds.\nGrievous Wounds does not stack; the duration of the debuff will overlap on separate effects and refresh on the same effect.",
      "url": "https://wiki.leagueoflegends.com/en-us/Grievous_Wounds"
    },
    {
      "id": "On-hit",
      "sha256": "5e179fac357b1ecc969e9a0d78a002d585a3a239c27a56252848d127b1254511",
      "text": "Attack effects are effects that trigger on a champion's basic attacks.\nThe following effects are applied and/or triggered when a champion's basic attack has hit the target.\nApplying on-hit effects[edit | edit source]\nAkshan's Dirty Fighting and Heroic Swing (25% on-hit damage effectiveness)\nEzreal's Mystic Shot",
      "url": "https://wiki.leagueoflegends.com/en-us/On-hit"
    }
  ],
  "findings": [
